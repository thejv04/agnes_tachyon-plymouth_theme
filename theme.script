screen_width = 1920;
screen_height = 1080;

scale = 0.5;

for (i = 1; i <= 15; i++) {
    agnes = Image("f-" + i + ".png");
    frames[i] = agnes.Scale(
        Math.Int(agnes.GetWidth() * scale),
        Math.Int(agnes.GetHeight() * scale)
    );
}

spr = Sprite();

frame_width = frames[1].GetWidth();

frame_height = frames[1].GetHeight();

spr.SetX(screen_width / 2 - frame_width / 2);

spr.SetY(screen_height / 2 - frame_height / 2);

current = 1;
direction = 1;
tick = 0;
speed = 3;
spin = 0;
spinner_sprite = Sprite();

fun refresh_cb() {
    tick = tick + 1;
    if (tick >= speed) {
        tick = 0;
        spr.SetImage(frames[current]);
        current = current + direction;
        if (current > 15) {
            current = 14;
            direction = -1;
        } else if (current < 1) {
            current = 2;
            direction = 1;
        }
    }

    if (spin < 3.14 * 2) {
        spin = spin + 0.1;
    } else {
        spin = 0;
    }

    spinner_img = Image("spinner.png").Rotate(spin);
    spinner_sprite.SetImage(spinner_img);
    spinner_sprite.SetX(screen_width / 2 - spinner_img.GetWidth() / 2);
    spinner_sprite.SetY(screen_height / 2 + frame_height / 2 + 20);
}

Plymouth.SetRefreshFunction(refresh_cb);